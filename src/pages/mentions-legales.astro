<style lang="scss">
  .legal-page {
    max-width: 1400px;
    margin: auto;
    background: white;
  }

  .lu-container {
    max-width: 900px;
    padding-block: var(--sectionPadding);
  }

  .legal-content {
    h2 {
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--color-primary);
      margin: 2.5rem 0 1rem 0;

      &:first-child {
        margin-top: 0;
      }
    }

    p {
      font-size: 1rem;
      line-height: 1.8em;
      color: var(--bodyTextColor);
      margin: 0 0 1.25rem 0;

      strong {
        font-weight: 700;
        color: var(--headerColor);
      }
    }

    a {
      color: var(--color-primary);
      text-decoration: underline;

      &:hover {
        color: var(--color4);
      }
    }

    .last-update {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid #e0e0e0;
      font-style: italic;
      color: #666;
    }
  }
</style>
