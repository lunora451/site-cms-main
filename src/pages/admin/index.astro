---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import CollectionList from "../../admin/components/CollectionList.svelte";
import { getAllCollections } from "../../libs/admin/collections";
import { listFiles, getFile } from "../../libs/admin/github";
import { parseFrontmatter } from "../../libs/admin/markdown";
import { env } from "cloudflare:workers";

const runtimeEnv = env;
const collections = getAllCollections();

const activeCollection = Astro.url.searchParams.get("collection");

// Gather stats
let totalArticles = 0;
let totalSize = 0;
const collectionData: Array<{
    name: string;
    title: string;
    description: string;
    count: number;
    totalSize: number;
    files: Array<{
        name: string;
        title: string;
        size: number;
        published: boolean;
    }>;
}> = [];

for (const [name, config] of Object.entries(collections)) {
    // If a collection is selected, only process that one
    if (activeCollection && activeCollection !== name) continue;

    const files = await listFiles(name, runtimeEnv);
    const count = files.length;
    const size = files.reduce((s, f) => s + f.size, 0);
    totalArticles += count;
    totalSize += size;

    collectionData.push({
        name,
        title: config.title || name,
        description: config.description || "",
        count,
        totalSize: size,
        files: await Promise.all(
            files.map(async (f) => {
                // Fetch frontmatter to get published status
                try {
                    const fd = await getFile(name, f.name, runtimeEnv);
                    if (fd) {
                        const parsed = parseFrontmatter(fd.content);
                        return {
                            name: f.name,
                            title: String(
                                parsed.frontmatter.title ||
                                    f.name
                                        .replace(/\.md$/, "")
                                        .replace(/-/g, " "),
                            ),
                            size: f.size,
                            published: parsed.frontmatter.published !== false,
                        };
                    }
                } catch (e) {}
                return {
                    name: f.name,
                    title: f.name.replace(/\.md$/, "").replace(/-/g, " "),
                    size: f.size,
                    published: true,
                };
            }),
        ),
    });
}

const pageTitle = activeCollection ? activeCollection : "Tout";
---

<AdminLayout title={pageTitle} activePage="dashboard">
    <div class="admin-header">
        <h1>
            {
                activeCollection ? (
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style="margin-right: 0.75rem; vertical-align: middle; opacity: 0.7;"
                    >
                        <path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z" />
                    </svg>
                ) : (
                    <svg
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        style="margin-right: 0.75rem; vertical-align: middle; opacity: 0.7;"
                    >
                        <>
                            <rect width="18" height="18" x="3" y="3" rx="2" />
                            <path d="M3 9h18" />
                            <path d="M9 21V9" />
                        </>
                    </svg>
                )
            }
            {pageTitle}
        </h1>
    </div>

    <!-- Collections -->
    <div
        class="admin-grid"
        style="display: flex; flex-direction: column; gap: 1rem;"
    >
        {
            collectionData.map((col) => {
                const config = collections[col.name];
                const showPublished = config?.fields.some(
                    (f) => f.name === "published",
                );
                return (
                    <CollectionList
                        client:load
                        collectionName={col.name}
                        files={col.files}
                        description={col.description}
                        showPublished={showPublished}
                    />
                );
            })
        }
    </div>
</AdminLayout>
