---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="container404">
    <h2>
      Bonjour, vous vous êtes perdu sur une page qui n'existe pas ! &#x1F98B;
    </h2>
    <a href="/" class="cs-button-solid-red-to-green">Retourner en lieu sûre !</a
    >
  </div>
</Layout>
<style lang="scss">
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  .container404 {
    flex: 1;
    height: 100%;
    display: flex;
    padding-top: 140px;
    gap: 1rem;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    h2 {
      text-align: center;
      max-width: 600px;
      line-height: 150%;
    }
    .cs-button-solid-red-to-green {
      cursor: pointer;
      max-width: 200px;
    }
  }
</style>
