<style lang="scss">
  /*-- -------------------------- -->
<---     Mobile Navigation      -->
<--- -------------------------- -*/
  /* Mobile - 1023px */
  @media only screen and (max-width: 1024px) {
    body {
      &.cs-open {
        overflow: hidden;
      }

      &.scroll {
        #cs-navigation {
          position: fixed;
          background-color: var(--bg-light);

          transform: translateY(-3.5125rem);
        }
      }
    }

    .page-active {
      font-weight: 700;
      // Annuler les styles page-active pour les liens dropdown qui ne sont pas actifs
      .cs-drop-link:not(.drop-active) {
        font-weight: normal;
      }
    }

    #cs-navigation {
      color: var(--text-black);
      width: 100%;
      /* prevents padding from affecting height and width */
      box-sizing: border-box;
      background-color: var(--bg-light);
      box-shadow: rgba(149, 157, 165, 0.4) 0px 8px 24px;
      position: fixed;
      z-index: 10000;
      transition: transform 0.3s;

      &:before {
        content: "";
        width: 100%;
        height: 0vh;
        background: rgba(0, 0, 0, 0.6);
        opacity: 0;
        display: block;
        position: absolute;
        top: 100%;
        right: 0;
        z-index: -1100;
        transition:
          height 0.5s,
          opacity 0.5s;
        -webkit-backdrop-filter: blur(10px);
        backdrop-filter: blur(10px);
      }

      &.cs-active {
        &:before {
          height: 150vh;
          opacity: 1;
        }

        .cs-ul-wrapper {
          opacity: 1;
          transform: scaleY(1);
          transition-delay: 0.15s;
        }

        .cs-li {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .cs-top-bar {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        background-color: var(--bg);
      }

      .cs-top-container {
        width: 100%;
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .cs-top-contact {
        width: auto;
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        display: flex;
        justify-content: center;
        align-items: center;
        /* 16px - 24px */
        gap: clamp(1rem, 2vw, 1.5rem);
      }

      .cs-top-link {
        font-size: calc(14 / 16 * 1rem);
        line-height: 1.5em;
        text-decoration: none;
        margin: 0;
        color: #1a1a1a;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
        position: relative;

        &:nth-of-type(2) {
          display: none;
        }
      }

      .cs-link-icon {
        width: calc(16 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-top-social {
        opacity: 1;
        display: flex;
        visibility: visible;
        justify-content: center;
        align-items: center;
        gap: 1rem;
        transition:
          opacity 0.3s,
          visibility 0.3s,
          height 0.3s;
      }

      .cs-social-link {
        text-decoration: none;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: calc(16 / 16 * 1rem);
      }

      .cs-social-icon {
        width: calc(20 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-container {
        width: 100%;
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        padding: 0 1rem;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        position: relative;
      }

      .cs-logo {
        width: auto;
        height: 100%;
        margin: 0 auto 0 0;
        /* prevents padding from affecting height and width */
        box-sizing: border-box;
        padding: 0;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        order: 1;
        z-index: 10;
        height: 85px;

        img {
          width: auto;
          height: 65px;
          /* ensures the image never overflows the container. It stays contained within it's width and height and expands to fill it then stops once it reaches an edge */
          object-fit: contain;
        }

        .c-logo-t {
          display: block;
          .logo-t-top {
            font-family: var(--headerFont);
            color: white;
            text-transform: uppercase;
            font-size: 1.6rem;
            letter-spacing: 0.09rem;
            font-weight: 700;
            line-height: 2.5rem;
          }
          .logo-t-bottom {
            font-family: var(--bodyFont);
            color: white;
            text-transform: capitalize;
            font-size: 0.875rem;
            letter-spacing: 0.08rem;
            line-height: 1.5em;
          }
        }
      }

      .cs-nav {
        order: 2;
      }

      .cs-toggle {
        width: calc(46 / 16 * 1rem);
        height: calc(46 / 16 * 1rem);
        margin: 0 0 0 auto;
        background-color: var(--color-primary);
        border-radius: 0.25rem;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: transform 0.6s;

        &.cs-active {
          color: var(--color-primary);
          transform: rotate(180deg);
        }
      }

      .cs-active {
        .cs-line1 {
          top: 50%;
          transform: translate(-50%, -50%) rotate(225deg);
        }

        .cs-line2 {
          top: 50%;
          transform: translate(-50%, -50%) translateY(0) rotate(-225deg);
          transform-origin: center;
        }

        .cs-line3 {
          opacity: 0;
          bottom: 100%;
        }
      }

      .cs-box {
        /* 24px - 28px */
        width: clamp(1.5rem, 2vw, 1.75rem);
        height: calc(12 / 16 * 1rem);
        position: relative;
      }

      .cs-line {
        width: 100%;
        height: 2px;
        background-color: #fafbfc;
        border-radius: 2px;
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
      }

      .cs-line1 {
        top: 0;
        transition:
          transform 0.5s,
          top 0.3s,
          left 0.3s;
        animation-duration: 0.7s;
        animation-timing-function: ease;
        animation-direction: normal;
        animation-fill-mode: forwards;
        transform-origin: center;
      }

      .cs-line2 {
        top: 50%;
        transform: translateX(-50%) translateY(-50%);
        transition:
          top 0.3s,
          left 0.3s,
          transform 0.5s;
        animation-duration: 0.7s;
        animation-timing-function: ease;
        animation-direction: normal;
        animation-fill-mode: forwards;
      }

      .cs-line3 {
        bottom: 0;
        transition:
          bottom 0.3s,
          opacity 0.3s;
      }

      .cs-ul-wrapper {
