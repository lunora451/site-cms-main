                  fill="#758CA3"></path></g
              ></svg
            >
          </a>
        </li>
        <li class="cs-social-li">
          <a
            href="https://share.google/JerVlUR7geFGVQNyy"
            class="cs-social-link"
            aria-label="fiche gmb"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              class="cs-social-icon cs-default"
              viewBox="0 0 24 24"
              fill="currentColor"
              width="12"
              height="12"
              xmlns="http://www.w3.org/2000/svg"
              ><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g
                id="SVGRepo_tracerCarrier"
                stroke-linecap="round"
                stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier">
                <path
                  d="M19.76 10.77L19.67 10.42H12.23V13.58H16.68C16.4317 14.5443 15.8672 15.3974 15.0767 16.0029C14.2863 16.6084 13.3156 16.9313 12.32 16.92C11.0208 16.9093 9.77254 16.4135 8.81999 15.53C8.35174 15.0685 7.97912 14.5191 7.72344 13.9134C7.46777 13.3077 7.33407 12.6575 7.33 12C7.34511 10.6795 7.86792 9.41544 8.79 8.47002C9.7291 7.58038 10.9764 7.08932 12.27 7.10002C13.3779 7.10855 14.4446 7.52101 15.27 8.26002L17.47 6.00002C16.02 4.70638 14.1432 3.9941 12.2 4.00002C11.131 3.99367 10.0713 4.19793 9.08127 4.60115C8.09125 5.00436 7.19034 5.59863 6.43 6.35002C4.98369 7.8523 4.16827 9.85182 4.15152 11.9371C4.13478 14.0224 4.918 16.0347 6.34 17.56C7.12784 18.3449 8.06422 18.965 9.09441 19.3839C10.1246 19.8029 11.2279 20.0123 12.34 20C13.3484 20.0075 14.3479 19.8102 15.2779 19.42C16.2078 19.0298 17.0488 18.4549 17.75 17.73C19.1259 16.2171 19.8702 14.2347 19.83 12.19C19.8408 11.7156 19.8174 11.2411 19.76 10.77Z"
                  fill="currentColor"></path>
              </g></svg
            >
          </a>
        </li>
      </ul>
      <span class="cs-copyright">
        <a href="/mentions-legales" class="legal">Mentions légales</a>
        <a href="/politique-de-confidentialite" class="privacy"
          >Politique de confidentialité</a
        >
      </span>
    </div>
  </div>
</footer>

<style lang="scss">
  /*-- -------------------------- -->
<---          Footer            -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #footer {
      padding-block: clamp(3.75rem, 7.82vw, 6.25rem) 1rem;
      position: relative;
      z-index: 1;
      background-color: var(--text-white);
      background-color: #efefef;

      .lu-container {
        margin: auto;
        width: 100%;
        max-width: calc(1280 / 16 * 1rem);
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .cs-top {
        width: 100%;
        /* 32px - 40px */
        margin-bottom: clamp(2rem, 4vw, 2.5rem);
        padding-bottom: clamp(2rem, 4vw, 2.5rem);
        border-bottom: 1px solid #e8e8e8;
        display: flex;
        flex-direction: column;
        gap: calc(32 / 16 * 1rem);
      }

      .cs-nav-container {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }

      .cs-ul-standard {
        margin: 0;
        padding: 0;
        list-style: none;

        .cs-li {
          margin-bottom: 0.5rem;
          position: relative;

          .cs-link {
            text-decoration: none;
            color: var(--bodyTextColor);
            transition: color 0.3s ease;
            display: inline-block;
            position: relative;

            &::after {
              content: "";
              position: absolute;
              width: 0;
              height: 1px;
              bottom: -2px;
              left: 0;
              background-color: var(--color-primary);
              transition: width 0.3s ease;
            }

            &:hover {
              color: var(--color-primary);

              &::after {
                width: 100%;
              }
            }
          }
        }
      }

      .service-list {
        .lu-sub-title {
          margin-bottom: 1rem;
          padding-bottom: 0.25rem;
          width: fit-content;
          border-bottom: 1px solid #646464;
        }

        .cs-ul-service {
          margin: 0;
          padding: 0;
          list-style: none;

          .cs-li {
            margin-bottom: 0.25rem;

            .cs-link {
              text-decoration: none;
              color: var(--bodyTextColor);
              transition: color 0.3s ease;
              display: inline-block;
              position: relative;

              &::after {
                content: "";
                position: absolute;
                width: 0;
                height: 1px;
                bottom: -2px;
                left: 0;
                background-color: var(--color-primary);
                transition: width 0.3s ease;
              }

              &:hover {
                color: var(--color-primary);

                &::after {
                  width: 100%;
                }
              }
            }
          }
        }
      }

      .learn-more-list {
        .lu-sub-title {
          margin-bottom: 1rem;
          padding-bottom: 0.25rem;
          width: fit-content;

          border-bottom: 1px solid #646464;
        }

        .cs-ul-learn-more {
          margin: 0;
          padding: 0;
          list-style: none;

          .cs-li {
            margin-bottom: 0.25rem;

            .cs-link {
              text-decoration: none;
              color: var(--bodyTextColor);
              transition: color 0.3s ease;
              display: inline-block;
              position: relative;

              &::after {
                content: "";
                position: absolute;
                width: 0;
                height: 1px;
                bottom: -2px;
                left: 0;
                background-color: var(--color-primary);
                transition: width 0.3s ease;
              }

              &:hover {
                color: var(--color-primary);

                &::after {
                  width: 100%;
                }
              }
            }
          }
        }
      }

      .cs-logo {
        width: calc(168 / 16 * 1rem);
        height: auto;
        display: block;
      }

      .cs-logo-img {
        width: 100%;
        height: auto;
        display: block;
      }

      .cs-bottom {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(24 / 16 * 1rem);
      }

      .cs-social {
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: calc(8 / 16 * 1rem);
      }

      .cs-social-li {
        list-style: none;
      }

      .cs-social-link {
        width: calc(32 / 16 * 1rem);
        height: calc(32 / 16 * 1rem);
        background-color: #e8e8e8;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: background-color 0.3s;

        &:hover {
          background-color: var(--color-primary);

          .cs-social-icon {
            color: var(--bodyTextColor);
            filter: grayscale(1) brightness(1000%);
            opacity: 1;
          }
        }
      }

      .cs-social-icon {
        width: calc(12 / 16 * 1rem);
        height: auto;
        color: var(--bodyTextColor);
        display: block;
        opacity: 0.6;
        filter: brightness(0);
        transition: opacity 0.3s;
      }

      .cs-copyright {
        font-size: calc(16 / 16 * 1rem);
        line-height: 1.5em;
        margin: 0;
        color: var(--bodyTextColor);
        display: block;
        gap: 2rem;
        display: flex;
        justify-content: center;
        text-align: center;

        a {
          text-decoration: none;
          color: var(--bodyTextColor);
          transition: color 0.3s ease;

          &:hover {
            color: var(--color-primary);
          }
        }
      }

      .cs-copyright-link {
        font-size: inherit;
        text-decoration: none;
        color: inherit;
        transition: color 0.3s;

        &:hover {
          color: var(--color-primary);
        }
      }
    }
  }

  /* Tablet - 768px */
  @media only screen and (min-width: 48rem) {
    #footer {
      .cs-top {
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-start;
      }

      .cs-nav-container {
        flex-direction: row;
        gap: 7rem;
        flex: 1;
        justify-content: flex-end;
      }

      .cs-bottom {
        flex-direction: row;
        justify-content: space-between;
      }
    }
  }
</style>
