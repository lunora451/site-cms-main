---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import CollectionList from "../../admin/components/CollectionList.svelte";
import { getAllCollections } from "../../libs/admin/collections";
import { listFiles, getFile } from "../../libs/admin/github";
import { parseFrontmatter } from "../../libs/admin/markdown";
import { env } from "cloudflare:workers";

const runtimeEnv = env;
const collections = getAllCollections();
const activeCollection = Astro.url.searchParams.get("collection");

// Gather stats
let totalArticles = 0;
let totalSize = 0;
const collectionData: Array<{
    name: string;
    title: string;
    description: string;
    count: number;
    totalSize: number;
    files: Array<{
        name: string;
        title: string;
        size: number;
        published: boolean;
    }>;
}> = [];

for (const [name, config] of Object.entries(collections)) {
    // If a collection is selected, only process that one
    if (activeCollection && activeCollection !== name) continue;

    const files = await listFiles(name, runtimeEnv);
    const count = files.length;
    const size = files.reduce((s, f) => s + f.size, 0);
    totalArticles += count;
    totalSize += size;

    collectionData.push({
        name,
        title: config.title || name,
        description: config.description || "",
        count,
        totalSize: size,
        files: await Promise.all(
            files.map(async (f) => {
                // Fetch frontmatter to get published status
                try {
                    const fd = await getFile(name, f.name, runtimeEnv);
                    if (fd) {
                        const parsed = parseFrontmatter(fd.content);
                        return {
                            name: f.name,
                            title: String(
                                parsed.frontmatter.title ||
                                    f.name
                                        .replace(/\.md$/, "")
                                        .replace(/-/g, " "),
                            ),
                            size: f.size,
                            published: parsed.frontmatter.published !== false,
                        };
                    }
                } catch (e) {}
                return {
                    name: f.name,
                    title: f.name.replace(/\.md$/, "").replace(/-/g, " "),
                    size: f.size,
                    published: true,
                };
            }),
        ),
    });
}

const pageTitle = activeCollection ? activeCollection : "Tout";
---

<AdminLayout title={pageTitle} activePage="dashboard">
    <div class="admin-header">
        <h1>{activeCollection ? (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem; vertical-align: middle; opacity: 0.7;"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z"/></svg>
        ) : (
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.75rem; vertical-align: middle; opacity: 0.7;"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        )} {pageTitle}</h1>
        <button id="deploy-btn" class="admin-btn admin-btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-5c1.62-2.2 5-3 5-3"/><path d="M12 15v5s3.03-.55 5-2c2.2-1.62 3-5 3-5"/></svg>
            <span class="btn-text">Mise à jour</span>
        </button>
    </div>

    <script is:inline>
        const deployBtn = document.getElementById("deploy-btn");
        if (deployBtn) {
            deployBtn.addEventListener("click", async () => {
                const btnText = deployBtn?.querySelector(".btn-text");
                const originalText = btnText?.textContent || "Mise à jour";

                deployBtn.setAttribute("disabled", "true");
                if (btnText) btnText.textContent = "Lancement...";
                
                try {
                    const res = await fetch("/api/admin/deploy", { method: "POST" });
                    const data = await res.json();
                    if (res.ok) {
                        window.showToast?.("Déploiement lancé avec succès !", "success");
                    } else {
                        window.showToast?.("Erreur : " + (data.error || "Échec"), "error");
                    }
                } catch (e) {
                    window.showToast?.("Erreur réseau.", "error");
                } finally {
                    deployBtn.removeAttribute("disabled");
                    if (btnText) btnText.textContent = originalText;
                }
            });
        }
    </script>

    <!-- Collections -->
    <div class="admin-grid" style="display: flex; flex-direction: column; gap: 1rem;">
        {
            collectionData.map((col) => (
                <CollectionList
                    client:load
                    collectionName={col.name}
                    files={col.files}
                    description={col.description}
                />
            ))
        }
    </div>
</AdminLayout>
